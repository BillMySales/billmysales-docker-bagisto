# Development environment. Usage: cp .env.dev.example .env && docker compose up -d --build
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL (shop at /, admin at /admin), plain HTTP on port 8118.
BAGISTO_URL=http://localhost:8118
BAGISTO_ADMIN_PATH=admin
SITE_ADDRESS=:80
HTTP_PORT=8118
HTTPS_PORT=8418
MAILPIT_PORT=8025
PHP_DISPLAY_ERRORS=On
LOG_LEVEL=debug

# Dev-only secrets and credentials.
APP_KEY=base64:ZGV2LWFwcC1rZXktZGV2LWFwcC1rZXktZGV2LWFwcC0=
DB_PASSWORD=bagisto
DB_ROOT_PASSWORD=root
BAGISTO_ADMIN_EMAIL=admin@example.com
BAGISTO_ADMIN_PASSWORD=admin12345
BAGISTO_STORE_NAME=Tienda

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com
SMTP_FROM_NAME=Tienda
