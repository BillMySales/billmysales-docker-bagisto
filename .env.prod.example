# Production environment. Usage: cp .env.prod.example .env, fill in the
# REQUIRED values, then docker compose up -d --build
# Commented-out lines show the default value.

# ---------------------------------------------------------------------------
# Optional services, comma separated: backup, mailpit (dev only), tools
# (console).
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=backup
#COMPOSE_PROJECT_NAME=bagisto

# Optional overrides (see overrides/*.yaml), combined with ":", e.g.
#COMPOSE_FILE=compose.yaml:overrides/traefik.yaml:overrides/local-dirs.yaml
# overrides/traefik.yaml: publish through an existing Traefik (then set
# SITE_ADDRESS=:80 below). TRAEFIK_HOST is REQUIRED with it (no default).
#TRAEFIK_HOST=shop.example.com
#TRAEFIK_NETWORK=shared_network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
# overrides/local-dirs.yaml: data in local directories instead of volumes.
#DATA_DIR=./data

# ---------------------------------------------------------------------------
# Site and network
# ---------------------------------------------------------------------------
# REQUIRED. Public URL of the shop. Links, emails and the channel's hostname
# use it (rewritten on every `up`); Bagisto only answers to its host (and
# the extra hosts below): other Host headers are refused.
BAGISTO_URL=https://shop.example.com
# Other host names Bagisto answers to (comma separated), e.g. www.example.com.
#BAGISTO_EXTRA_HOSTS=
# REQUIRED. Path of the admin panel (<url>/<path>): not the well-known
# "admin" in production (letters, digits, - and _).
BAGISTO_ADMIN_PATH=
# Caddy site address: a domain gets an automatic Let's Encrypt certificate
# (DNS must point here and ports 80/443 must be reachable). Use ":80" behind
# another TLS-terminating proxy, or "localhost" for local HTTPS.
SITE_ADDRESS=shop.example.com
# Interface to publish ports on: 0.0.0.0 = all (public server).
HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
#TIMEZONE=America/Santiago

# ---------------------------------------------------------------------------
# Secrets and credentials (REQUIRED)
# ---------------------------------------------------------------------------
# Laravel encryption key (sessions, encrypted settings): "base64:" +
# openssl rand -base64 32. Keep a copy: it isn't in the backups.
APP_KEY=
# openssl rand -hex 32
DB_PASSWORD=
DB_ROOT_PASSWORD=
# First admin user (created on the first install; its password is set only
# then). The email is also the store's admin notification address.
BAGISTO_ADMIN_EMAIL=
BAGISTO_ADMIN_PASSWORD=
#BAGISTO_ADMIN_NAME=Admin
#DB_USER=bagisto
#DB_NAME=bagisto

# ---------------------------------------------------------------------------
# Store: Laravel app settings, read on every start. Set them before the first
# install.
# ---------------------------------------------------------------------------
# APP_NAME: the admin's name for the app (logos' alt text), and the channel's
# name and home title on the first install (then edited in the admin).
#BAGISTO_STORE_NAME=Bagisto
# APP_LOCALE and APP_CURRENCY: the default locale and the base currency on
# every request, and the install's data (channel, categories, CMS pages,
# emails). Don't change them after the install: the database must have that
# locale and currency.
#BAGISTO_LOCALE=es
#BAGISTO_CURRENCY=CLP

# ---------------------------------------------------------------------------
# Store (initial settings: applied once on the first `up`; later changes in
# the admin are kept)
# ---------------------------------------------------------------------------
#BAGISTO_COUNTRY=CL
#BAGISTO_CITY=Santiago
# Tax rate (%) for the country; empty = none.
#BAGISTO_TAX_RATE=19
#BAGISTO_TAX_NAME=IVA
# Prices include tax (as usual in Chile).
#BAGISTO_PRICES_INCLUDE_TAX=true

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Bagisto, built into the image (image/Dockerfile) from the release's source
# with its Composer lock. After changing it, `docker compose up -d --build`
# rebuilds and setup runs the migrations. Back up first and read Bagisto's
# UPGRADE.md for a new minor version. Set BAGISTO_SHA256 to the new
# archive's SHA-256 (empty: not checked).
#BAGISTO_VERSION=2.4.12
#BAGISTO_SHA256=f81ce2382c53bd4db5b30bde39001ded29ae9609fa13e674e0b7eabf46d27e2c
# Bagisto 2.4 supports PHP 8.3 and 8.4.
#PHP_VERSION=8.4
#BAGISTO_IMAGE=bagisto-fpm
#MARIADB_VERSION=12.3
#CADDY_VERSION=2.11
#MAILPIT_VERSION=v1.31
# Mailpit's web UI (development only).
#MAILPIT_PORT=8025

# ---------------------------------------------------------------------------
# Mail (SMTP, recommended): order, invoice, shipment and refund emails,
# customer accounts, password resets, admin notifications. SMTP settings saved
# in the admin (Configuration > Emails) take precedence. Without SMTP_HOST no
# emails are sent (discarded; logged only with LOG_LEVEL=debug).
# ---------------------------------------------------------------------------
SMTP_HOST=
#SMTP_PORT=587
# ssl = SMTPS (usually port 465); anything else (tls, none): STARTTLS when
# the server offers it (Bagisto's mailer has no "never TLS" mode).
#SMTP_SECURE=tls
#SMTP_USER=
#SMTP_PASSWORD=
# Sender address and name (also the contact address shown to customers).
#SMTP_FROM=shop@example.com
#SMTP_FROM_NAME=Bagisto

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
#BACKUP_INTERVAL_HOURS=24
#BACKUP_KEEP_DAYS=7

# ---------------------------------------------------------------------------
# PHP, resources and logs
# ---------------------------------------------------------------------------
# Laravel's log level (logs go to docker compose logs): debug ... critical.
#LOG_LEVEL=warning
# Error details in pages: never true on a public server.
#APP_DEBUG=false
#PHP_MEMORY_LIMIT=512M
#PHP_MAX_EXECUTION_TIME=120
#PHP_DISPLAY_ERRORS=Off
# 1 = PHP checks files for changes (only useful when editing code in place).
#PHP_OPCACHE_VALIDATE_TIMESTAMPS=0
#PHP_FPM_MAX_CHILDREN=10
#PHP_FPM_START_SERVERS=2
#PHP_FPM_MIN_SPARE_SERVERS=1
#PHP_FPM_MAX_SPARE_SERVERS=4
#PHP_FPM_MAX_REQUESTS=500
#UPLOAD_MAX_SIZE=32M
#DB_MEMORY_LIMIT=1g
#SETUP_MEMORY_LIMIT=1g
#PHP_MEMORY_LIMIT_CONTAINER=1g
#WORKER_MEMORY_LIMIT=512m
#SCHEDULER_MEMORY_LIMIT=512m
#CONSOLE_MEMORY_LIMIT=1g
#CADDY_MEMORY_LIMIT=256m
#BACKUP_MEMORY_LIMIT=512m
#LOG_MAX_SIZE=10m
#LOG_MAX_FILE=3
